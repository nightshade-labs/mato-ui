{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mato-ui",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mato.markets",
      "custom_domain": true,
    },
  ],
  "env": {
    "devnet": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "devnet.mato.markets",
          "custom_domain": true,
        },
      ],
    },
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
    },
  },
}
